# Copia este archivo a .env y completa los valores. En Vercel, las mismas
# claves van en Project Settings -> Environment Variables.

# Clave con la que wiwo.doom publica en este sitio.
# Sin esto el endpoint de escritura del contrato existe pero rechaza todo, y el
# manifest anuncia write:false, así que el orquestador no ofrece este destino.
# La misma clave se carga en doom, en la página conectada.
WIWO_WRITE_TOKEN=

# Postgres del sitio. Sin esto el sitio funciona igual —las 51 notas del archivo
# viven en el repositorio— pero lo que publique el orquestador y las imágenes que
# suba se guardan en una base EN MEMORIA y se pierden en cada despliegue y en
# cada reinicio. Hace falta solo cuando se empiece a publicar desde doom.
DATABASE_URL=

# Propiedad de Google Analytics que mide este sitio (GA4).
# Vacia = el sitio NO emite ningun script de medicion, ni en produccion ni en
# vista previa. Se deja vacia a proposito en el repositorio: con el
# identificador escrito aca, cada rama en revision mandaria sus visitas a la
# propiedad de verdad. En Vercel se carga SOLO en el entorno Production.
VITE_GA_MEASUREMENT_ID=
